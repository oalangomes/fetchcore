# FetchCore runtime image and mounted repository.
FETCHCORE_IMAGE=fetchcore:dev
FETCHCORE_WORKSPACE=.
FETCHCORE_MCP_REPOSITORY=local/repository

# MCP serving defaults.
FETCHCORE_MCP_BACKEND=local-semantic
FETCHCORE_MCP_REVISION=
FETCHCORE_MCP_BACKEND_SETTINGS=
FETCHCORE_MCP_RETRIEVAL=
FETCHCORE_MCP_KNOWLEDGE_TYPES=
FETCHCORE_MCP_REPOSITORY_PATHS=

# Optional external embedding provider.
OLLAMA_URL=http://host.docker.internal:11434

# Local backend ports.
SOLR_PORT=8983
OPENSEARCH_PORT=9200
OPENSEARCH_METRICS_PORT=9600
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Backend examples for the FetchCore runtime container:
#
# Solr:
# FETCHCORE_MCP_BACKEND=solr
# FETCHCORE_MCP_BACKEND_SETTINGS={"url":"http://solr:8983/solr","collection":"fetchcore-knowledge","projection_version":"3"}
#
# OpenSearch:
# FETCHCORE_MCP_BACKEND=opensearch
# FETCHCORE_MCP_BACKEND_SETTINGS={"url":"http://opensearch:9200","index":"fetchcore-knowledge","projection_version":"3"}
#
# Qdrant:
# FETCHCORE_MCP_BACKEND=qdrant-vector
# FETCHCORE_MCP_BACKEND_SETTINGS={"url":"http://qdrant:6333","collection":"fetchcore-vector","embedding_url":"http://host.docker.internal:11434","embedding_model":"embeddinggemma","projection_version":"3"}
