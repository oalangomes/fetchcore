# FetchCore runtime image and mounted repository.
FETCHCORE_IMAGE=fetchcore:dev
FETCHCORE_WORKSPACE=.
FETCHCORE_MCP_REPOSITORY=local/repository

# Preferred operator-owned runtime YAML for direct process execution.
# Compose users must explicitly pass and mount the path into the container.
# FETCHCORE_CONFIG=/etc/fetchcore/config.yaml
# See docs/guides/runtime-configuration.md for the versioned YAML contract.

# Legacy Compose/MCP wiring retained for existing deployments.
# New process-level configuration should use FETCHCORE_BACKEND and the
# FETCHCORE_* URL overrides documented in the guide.
FETCHCORE_MCP_BACKEND=local-semantic
FETCHCORE_MCP_REVISION=
FETCHCORE_MCP_BACKEND_SETTINGS=
FETCHCORE_MCP_RETRIEVAL=
FETCHCORE_MCP_KNOWLEDGE_TYPES=
FETCHCORE_MCP_REPOSITORY_PATHS=

# Historical Ollama URL fallback. Prefer FETCHCORE_OLLAMA_URL in new deployments.
OLLAMA_URL=http://host.docker.internal:11434

# Local backend ports.
SOLR_COLLECTION=fetchcore-knowledge
SOLR_PORT=8983
OPENSEARCH_PORT=9200
OPENSEARCH_METRICS_PORT=9600
# Required when starting the OpenSearch profile (use a strong local password).
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Simple runtime overrides for direct process execution:
# FETCHCORE_BACKEND=solr
# FETCHCORE_SOLR_URL=http://solr:8983/solr
# FETCHCORE_OLLAMA_URL=http://host.docker.internal:11434
# FETCHCORE_QDRANT_API_KEY=  (supply securely; never commit a real key)
