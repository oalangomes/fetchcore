# Local DEV and BENCH use the repository checkout by default.
# These variables do not create additional Docker projects.
# Supported Compose files:
#   compose.dev.yml       -> fetchcore-dev
#   compose.yml           -> fetchcore (productive/operational)
#   compose.benchmark.yml -> fetchcore-benchmark
#
# DO NOT set COMPOSE_PROJECT_NAME, -p or an alternate COMPOSE_FILE.
FETCHCORE_LOCAL_SOURCE_PATH=.
FETCHCORE_REPOSITORY=oalangomes/fetchcore

# Production source/runtime MUST be exported as absolute, operator-verified
# paths before using compose.yml. These are intentionally not prefilled here:
# FETCHCORE_OPERATIONAL_SOURCE_PATH=/absolute/pinned/repository
# FETCHCORE_OPERATIONAL_RUNTIME_CONFIG=/absolute/verified/runtime.yml
#
# Productive index is preserved from external Docker volume:
#   fetchcore-operational-cloud_solrcloud-data
# DEV preserves the external:
#   fetchcore-shared_solrcloud-data
# BENCH alone creates a disposable volume.

# Optional provider, never started by the FetchCore three-project fleet:
# FETCHCORE_OLLAMA_URL=http://host.docker.internal:11434

# Existing developers who use standalone CLI processes can still configure
# runtime through an operator-owned file:
# FETCHCORE_CONFIG=/absolute/path/to/runtime.yml
# See docs/operations/docker-compose-three-environments.md.
