# Default: docker compose up -d --build --wait -> web + API + MCP + Solr.
# Never set COMPOSE_FILE for the default root Compose selection.
# Paths are resolved relative to infra/compose/app.yml; ../.. is repository root.
# For a custom source mount, use an absolute path and matching repository identity.
FETCHCORE_SOURCE_PATH=../..
FETCHCORE_REPOSITORY=oalangomes/fetchcore
FETCHCORE_SOLR_COLLECTION=fetchcore
FETCHCORE_SOLR_PORT=8983
FETCHCORE_WEB_PORT=5173
FETCHCORE_MCP_PORT=8766

# Retrieval backend for the shared application (Solr lexical/BM25 is default).
# Alternate modes need explicitly compatible persisted indexes and capabilities.
# FETCHCORE_BACKEND=opensearch
# FETCHCORE_BACKEND=qdrant-vector
FETCHCORE_OPENSEARCH_INDEX=fetchcore
FETCHCORE_QDRANT_COLLECTION=fetchcore

# Optional: only set retrieval policy when indexes, models and snapshots are ready (#123).
# FETCHCORE_RETRIEVAL={"dense":{"enabled":true,"embedding":{"provider":"ollama","model":"embeddinggemma"}},"hybrid":{"enabled":true}}
# FETCHCORE_OLLAMA_URL=http://host.docker.internal:11434

# Historical headless image and stdio runtime (profile runtime).
FETCHCORE_IMAGE=fetchcore:dev
FETCHCORE_WORKSPACE=.
FETCHCORE_MCP_REPOSITORY=local/repository

# Preferred operator-owned runtime YAML for direct process execution.
# Compose users must explicitly pass and mount the path into the container.
# FETCHCORE_CONFIG=/etc/fetchcore/config.yaml
# See docs/guides/runtime-configuration.md for the versioned YAML contract.

# Legacy Compose/MCP wiring retained for existing deployments.
# New process-level configuration should use FETCHCORE_BACKEND and the
# FETCHCORE_* URL overrides documented in the guide.
FETCHCORE_MCP_BACKEND=local-semantic
FETCHCORE_MCP_REVISION=
FETCHCORE_MCP_BACKEND_SETTINGS=
FETCHCORE_MCP_RETRIEVAL=
FETCHCORE_MCP_KNOWLEDGE_TYPES=
FETCHCORE_MCP_REPOSITORY_PATHS=

# Historical Ollama URL fallback. Prefer FETCHCORE_OLLAMA_URL in new deployments.
OLLAMA_URL=http://host.docker.internal:11434

# Legacy standalone backend host ports (see infra/compose/).
# SOLR_COLLECTION=fetchcore-knowledge  # replaced by FETCHCORE_SOLR_COLLECTION for this stack
# SOLR_PORT=8983  # replaced by FETCHCORE_SOLR_PORT for this stack
OPENSEARCH_PORT=9200
OPENSEARCH_METRICS_PORT=9600
# Required when starting the OpenSearch profile (use a strong local password).
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Simple runtime overrides for direct process execution:
# FETCHCORE_BACKEND=solr
# FETCHCORE_SOLR_URL=http://solr:8983/solr
# FETCHCORE_OLLAMA_URL=http://host.docker.internal:11434
# FETCHCORE_QDRANT_API_KEY=  (supply securely; never commit a real key)
